# ==============================================================================
# MIRAAJ CONFIGURATION
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# API Server Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL with SQLite fallback)
# ------------------------------------------------------------------------------
POSTGRES_USER=miraaj
POSTGRES_PASSWORD=miraaj
POSTGRES_DB=miraaj
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URL:
# For PostgreSQL: postgresql+asyncpg://miraaj:miraaj@localhost:5432/miraaj
# For SQLite local dev: sqlite+aiosqlite:///./miraaj_local.db
DATABASE_URL=sqlite+aiosqlite:///./miraaj_local.db

# ------------------------------------------------------------------------------
# Redis & Queue Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
# Provider: "local" (default) or "s3"
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/projects

# S3 Configuration (Future Extension)
# S3_BUCKET_NAME=miraaj-storage
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# Media Processing (FFmpeg / FFprobe)
# ------------------------------------------------------------------------------
# If ffmpeg is in your system PATH, leave empty or specify absolute paths:
FFMPEG_PATH=
FFPROBE_PATH=

# ------------------------------------------------------------------------------
# AI Provider Configuration (Optional / Local-first)
# Provider: "mock" (default, free, local-first), "openai", "anthropic", "gemini"
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Video Defaults
# ------------------------------------------------------------------------------
DEFAULT_WIDTH=1080
DEFAULT_HEIGHT=1920
DEFAULT_FPS=30
DEFAULT_STYLE=modern_creator_v1
